    titleKo: '제네바 코르나방 중앙역',
    titleFr: 'GARE DE GENÈVE-CORNAVIN · CFF FFS',
    descKo: '코르나방 광장 트램 허브 · 아르데코 석조 역사 · SBB & TGV 고속열차 플랫폼',
    gps: '46°12\'36.7"N  06°08\'32.6"E',
    altitudeBase: 46,
    mapPos: [0.38, 0.30]
  },
  {
    id: 'un',
    index: '04 / 06',
    startTime: 15.0,
    endTime: 20.0,
    titleKo: '유엔 유럽본부 (UN)',
    titleFr: 'PALAIS DES NATIONS · PLACE DES NATIONS',
    descKo: '부러진 의자(Broken Chair) · 만국기 가로수길 · 아리아나 공원 & 천구의',
    gps: '46°13\'35.8"N  06°08\'25.8"E',
    altitudeBase: 62,
    mapPos: [0.45, 0.12]
  },
  {
    id: 'placedeneuve',
    index: '05 / 06',
    startTime: 20.0,
