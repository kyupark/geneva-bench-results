import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.186.1/build/three.module.js';

export const TOUR_DURATION = 30.0; // seconds

export const LANDMARK_CHAPTERS = [
  {
    id: 'oldtown',
    index: '01 / 06',
    startTime: 0.0,
    endTime: 5.0,
    titleKo: '제네바 올드타운',
    titleFr: 'VIEILLE VILLE · CATHÉDRALE SAINT-PIERRE',
    descKo: '생피에르 대성당 첨탑 · 부르드푸르 광장 · 구시가지 중세 지붕',
    gps: '46°12\'04.3"N  06°08\'55.0"E',
    altitudeBase: 88,
    mapPos: [0.54, 0.68]
  },
  {
    id: 'lakeside',
    index: '02 / 06',
    startTime: 5.0,
    endTime: 10.0,
    titleKo: '제네바 호숫가 & 제트도',
    titleFr: 'RADE DE GENÈVE · JET D\'EAU · JARDIN ANGLAIS',
    descKo: '140m 제트도 대분수 · 영국공원 꽃시계 · 레만호 벨에포크 유람선 · 몽블랑교',
    gps: '46°12\'26.6"N  06°09\'21.2"E',
    altitudeBase: 54,
    mapPos: [0.74, 0.49]
  },
  {
    id: 'cornavin',
    index: '03 / 06',
    startTime: 10.0,
